<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    [MyBatis XML 매퍼 파일 구조]
    namespace : 이 XML과 연결되는 Mapper 인터페이스 전체 경로
    인터페이스의 메서드명 = 각 쿼리의 id 속성값으로 매핑
-->
<mapper namespace="com.green.book_shop_t.member.mapper.MemberMapper">

    <!--
        [resultMap이란?]
        DB 컬럼명(대문자_언더스코어)과 Java 필드명(소문자 카멜케이스)이 다를 때 매핑 규칙 정의
        예) MEM_EMAIL(DB 컬럼) → memEmail(Java 필드)

        id      : resultMap의 고유 이름 (쿼리에서 resultMap="member"로 참조)
        type    : 결과를 담을 Java 클래스 전체 경로
        <id>    : PK 컬럼 매핑 (MyBatis 내부 캐싱 및 중복 제거에 활용)
        <result>: 일반 컬럼 매핑
        column  : DB 컬럼명
        property: Java DTO 필드명
    -->
    <resultMap id="member" type="com.green.book_shop_t.member.dto.MemberDTO">
        <id     column="MEM_EMAIL"      property="memEmail" />
        <result column="MEM_PW"         property="memPw" />
        <result column="MEM_NAME"       property="memName" />
        <result column="MEM_TEL"        property="memTel" />
        <result column="MEM_ADDR"       property="memAddr" />
        <result column="ADDR_DETAIL"    property="addrDetail" />
        <result column="IS_USING"       property="isUsing" />
        <result column="MEM_ROLE"       property="memRole" />
        <result column="JOIN_DATE"      property="joinDate" />
    </resultMap>

    <!--
        [회원가입 쿼리]
        id = MemberMapper 인터페이스의 insertInfo 메서드와 연결
        #{memEmail} = MemberDTO.getMemEmail() 값을 PreparedStatement에 바인딩
        → ? 로 처리되어 SQL 인젝션 방지 (MyBatis의 # 문법)
        isUsing, memRole, joinDate 는 DB에서 DEFAULT 값으로 자동 처리
    -->
    <insert id="insertInfo">
        INSERT INTO SHOP_MEMBER(
            MEM_EMAIL
            ,MEM_PW
            ,MEM_NAME
            ,MEM_TEL
            ,MEM_ADDR
            ,ADDR_DETAIL
        )VALUES(
            #{memEmail}
            ,#{memPw}
            ,#{memName}
            ,#{memTel}
            ,#{memAddr}
            ,#{addrDetail}
        )
    </insert>

    <!--
        [이메일 중복 체크 쿼리]
        resultType="string" : 쿼리 결과를 String 타입으로 반환 (resultMap 없이 단순 타입)
        해당 이메일이 DB에 있으면 이메일 문자열 반환 → Service에서 중복으로 처리
        해당 이메일이 DB에 없으면 null 반환 → Service에서 사용 가능으로 처리
    -->
    <select id="checkEmail" resultType="string">
        SELECT MEM_EMAIL
        FROM SHOP_MEMBER
        WHERE MEM_EMAIL = #{memEmail}
    </select>

    <!--
        [로그인 쿼리]
        resultMap="member" : 결과를 위에 정의한 member resultMap 규칙으로 MemberDTO에 매핑
        보안상 비밀번호는 SELECT하지 않고 이메일, 이름, 권한만 반환
        WHERE 조건(이메일+비밀번호)이 일치하지 않으면 null 반환
        → Controller에서 null이면 로그인 실패 응답
    -->
    <select id="login" resultMap="member">
        SELECT MEM_EMAIL
            ,MEM_NAME
            ,MEM_ROLE
        FROM SHOP_MEMBER
        WHERE MEM_EMAIL = #{memEmail} AND MEM_PW = #{memPw}
    </select>


</mapper>
