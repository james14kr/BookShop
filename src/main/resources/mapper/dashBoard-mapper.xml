<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    namespace: 이 XML과 연결할 Mapper 인터페이스 전체 경로
    DashBoardMapper 인터페이스의 메서드명 = 각 쿼리 태그의 id 값
-->
<mapper namespace="com.green.book_shop_t.dashBoard.mapper.DashBoardMapper">

    <!--
        [학습 포인트] MariaDB 날짜 함수 정리
        ─────────────────────────────────────
        CURDATE()          : 오늘 날짜 반환 (예: '2026-03-05')
        NOW()              : 현재 날짜 + 시간 반환 (예: '2026-03-05 14:30:00')
        DATE(컬럼)         : datetime 컬럼에서 날짜 부분만 추출 (시간 제거)
        YEAR(컬럼)         : 연도 추출 (예: 2026)
        MONTH(컬럼)        : 월 추출 (예: 3)

        [DATE() 사용 이유]
        BUY_DATE가 DATETIME 타입 (예: '2026-03-05 14:30:00')이므로
        CURDATE() ('2026-03-05')와 직접 비교 불가
        → DATE(BUY_DATE) 로 날짜 부분만 추출 후 비교

        [학습 포인트] COUNT(*) vs COUNT(컬럼)
        COUNT(*) : NULL 포함 전체 행 수 (대부분 이쪽 사용)
        COUNT(컬럼) : 해당 컬럼이 NULL이 아닌 행 수만 카운트
    -->

    <!-- 오늘 주문건수 조회 | resultType="int" → Java int로 매핑 -->
    <select id="selectTodayOrderCount" resultType="int">
        SELECT COUNT(*)
        FROM SHOP_BUY
        WHERE DATE(BUY_DATE) = CURDATE()
        <!--
            DATE(BUY_DATE) : '2026-03-05 14:30:00' → '2026-03-05' 변환
            CURDATE()      : 오늘 날짜 '2026-03-05'
            → 오늘 날짜에 구매된 행만 카운트
        -->
    </select>

    <!-- 이번 달 주문건수 조회 | YEAR + MONTH 조건으로 월 단위 필터링 -->
    <select id="selectMonthOrderCount" resultType="int">
        SELECT COUNT(*)
        FROM SHOP_BUY
        WHERE YEAR(BUY_DATE)  = YEAR(NOW())
          AND MONTH(BUY_DATE) = MONTH(NOW())
        <!--
            YEAR(NOW())  : 현재 연도 (예: 2026)
            MONTH(NOW()) : 현재 월 (예: 3)
            → 2026년 3월에 구매된 행만 카운트
            → AND 조건으로 연도 + 월 동시 확인 (연도 없이 월만 비교하면 전년도 포함)
        -->
    </select>

    <!--
        [학습 포인트] COALESCE 함수
        ─────────────────────────────────────
        COALESCE(값1, 값2, ...)
        → 값1이 NULL 이면 값2 반환, 값2도 NULL 이면 값3... 순서로 최초 NULL이 아닌 값 반환

        SUM(BUY_PRICE) : 오늘 구매 건수가 0이면 결과 행 자체가 없어 NULL 반환
        → COALESCE(SUM(BUY_PRICE), 0) : NULL 대신 0 반환하여 NPE 방지

        resultType="long" : 매출액은 int(약 21억) 초과 가능 → long 사용
    -->

    <!-- 오늘 매출액 조회 | 오늘 구매 없으면 0 반환 -->
    <select id="selectTodaySales" resultType="long">
        SELECT COALESCE(SUM(BUY_PRICE), 0)
        FROM SHOP_BUY
        WHERE DATE(BUY_DATE) = CURDATE()
    </select>

    <!-- 이번 달 매출액 조회 | 이번 달 구매 없으면 0 반환 -->
    <select id="selectMonthSales" resultType="long">
        SELECT COALESCE(SUM(BUY_PRICE), 0)
        FROM SHOP_BUY
        WHERE YEAR(BUY_DATE)  = YEAR(NOW())
          AND MONTH(BUY_DATE) = MONTH(NOW())
    </select>

</mapper>
